# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=933568187035-q36oq51c47kaskugimat6fimecop33bm.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Cookie signing secret (generate a random string)
COOKIE_SECRET=change-me-to-a-random-string

# Server port
PORT=3000

# Environment
NODE_ENV=development

# Base path for subpath hosting (e.g. '/waymark' when served at swiftirons.com/waymark/)
# Leave empty or omit for running at root
# BASE_PATH=/waymark

# Set to "true" to enable local-only mode (mock data, no Google account needed)
# WAYMARK_LOCAL=true

# ── AI Agent Fleet ────────────────────────────────────────────────────────────
#
# These are read by `make up` to start the agent fleet.
# Edit here, then run `make up` — no other CLI flags needed.
#

# Space-separated names of agents to start (one container per name)
# Names appear in logs and in the Agent Registry UI
AGENT_NAMES=Alex

# AI provider: copilot | claude | auto (auto = detect from credentials)
PROVIDER=auto

# Copilot model (run `copilot --list-models` to see options)
MODEL=claude-sonnet-4.6

# Claude Code model (Anthropic model ID)
CLAUDE_MODEL=claude-opus-4-5

# Anthropic API key — required if PROVIDER=claude or PROVIDER=auto with no Copilot token
# ANTHROPIC_API_KEY=sk-ant-...

# Agent Registry Google Sheet ID — agents read tuning strings from this sheet on boot
# Create an "agents" template sheet in Waymark, then paste the sheet ID here
# AGENTS_SHEET_ID=

# Waymark workboard sheet ID — agents poll this for tasks
# WAYMARK_WORKBOARD_ID=

# Initial agent command (what the agent runs when it boots)
# COMMAND=@waymark-builder start

# Real-agent evals (comma or newline separated Gemini API keys; keep only in local .env)
# WAYMARK_AGENT_EVAL_KEYS=
# WAYMARK_AGENT_EVAL_MODEL=gemini-flash-latest

# ── Gemini Dream-RSI Engine (24/7 recursive self-improvement) ─────────────────
#
# ACTIVE_AGENT selects the engine FAMILY the dev-worker runs. This is the seam
# for the future V2 multi-agent system — engines are swappable via one variable.
#   copilot → keep the existing Copilot/Claude worker (default, unchanged)
#   gemini  → run the Gemini Dream-RSI loop instead
ACTIVE_AGENT=copilot

# Rotating pool of Gemini API keys — comma-separated, on a SINGLE line.
# Get keys at https://aistudio.google.com/app/apikey (one per Google account).
# The loop rotates to the next key on HTTP 429 / quota errors and parks the spent
# key on a 1-hour cooldown, so a larger pool ≈ continuous free-tier uptime.
# GEMINI_KEY_POOL=AIzaKEY1,AIzaKEY2,AIzaKEY3

# Gemini model used by the Dream-RSI loop
GEMINI_MODEL=gemini-flash-latest

# Per-key cooldown after a rate-limit hit, in milliseconds (default 1 hour)
# GEMINI_KEY_COOLDOWN_MS=3600000

# Discovery_Tree memory tab lives in this sheet. Leave blank to reuse the
# workboard sheet (WAYMARK_WORKBOARD_ID) — one control-plane sheet for everything.
# DISCOVERY_TREE_SHEET_ID=
# DISCOVERY_TREE_TAB=Discovery_Tree

# Adaptive compute — when a task keeps failing, generate this many alternative
# fixes in parallel across different keys, test each, and merge the winner.
# DREAM_FANOUT_N=3

# Max agent turns (tool actions) per attempt before giving up (default 24)
# DREAM_MAX_TURNS=24

# Max time a single test command may run during evaluation, in ms (default 10 min)
# DREAM_TEST_TIMEOUT_MS=600000

# Push winning branches to origin for QA review (1) or keep commits local only (0)
# DREAM_PUSH=1
